# OpenCheck Configuration

# Vision API - Choose ONE (Gemini recommended - fastest and cheapest)

# Google Gemini (Recommended)
# Get API key from: https://makersuite.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# OR use Claude
# Get Claude API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# OR use OpenAI
# Get OpenAI API key from: https://platform.openai.com/
OPENAI_API_KEY=your_openai_key_here

# Model Configuration
MODEL_PATH=models/chess_model.pth

# Screen Capture Settings
CAPTURE_INTERVAL=2.0  # seconds between captures
MONITOR_NUMBER=1      # which monitor to capture from

# Display Settings
SHOW_OVERLAY=true
SHOW_CONSOLE=true
